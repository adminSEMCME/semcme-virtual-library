NODE_ENV=production
PORT=3000
APP_BASE_URL=https://vlibrary.semcme.org
TRUST_PROXY=true
COOKIE_SECURE=true

# Reuse an existing Postgres database if needed. The Virtual Library tables use the vl_ prefix.
VIRTUAL_LIBRARY_DATABASE_URL=postgres://user:password@host:5432/database?sslmode=require
VIRTUAL_LIBRARY_SESSION_SECRET=replace-with-a-long-random-secret

# Admin login
GLOBAL_ADMIN_USERNAME=
GLOBAL_ADMIN_PASSWORD=

# Public registration
VIRTUAL_LIBRARY_REGISTRATION_URL=
VIRTUAL_LIBRARY_CACHE_MINUTES=10

# Constant Contact registration lookup
CONSTANT_CONTACT_CLIENT_ID=
CONSTANT_CONTACT_CLIENT_SECRET=
CONSTANT_CONTACT_ACCESS_TOKEN=
CONSTANT_CONTACT_REFRESH_TOKEN=
CONSTANT_CONTACT_VIRTUAL_LIBRARY_EVENT_ID=
CONSTANT_CONTACT_VIRTUAL_LIBRARY_TRACK_KEY=
CONSTANT_CONTACT_REGISTRATION_RECHECK_MINUTES=60

# Email delivery through Resend SMTP
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=SEMCME Virtual Library <library@mail.semcme.org>
